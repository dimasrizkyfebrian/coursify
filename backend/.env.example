# PostgreSQL Database Configuration
# These values are typically used when running with Docker Compose
DB_HOST=db
DB_PORT=5432
DB_USER=postgres_user_example 
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=coursify_db_example
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET_KEY=replace_with_a_very_strong_random_secret_key